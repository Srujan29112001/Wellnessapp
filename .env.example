# Application Settings
APP_NAME=Wellness AI
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
API_V1_PREFIX=/api/v1

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Database Configuration
# PostgreSQL (structured data: user profiles, metrics, goals)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wellness_db
POSTGRES_USER=wellness_user
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MongoDB (unstructured data: journals, raw signals)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=wellness_mongo
MONGODB_USER=wellness_user
MONGODB_PASSWORD=change-me-in-production
MONGODB_URL=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}

# Redis (caching, session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-production

# Vector Database (ChromaDB or Pinecone)
VECTOR_DB_TYPE=chroma  # Options: chroma, pinecone
CHROMA_PERSIST_DIR=./data/chroma_db
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp

# LLM Configuration
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local LLM (HuggingFace)
USE_LOCAL_LLM=True
LOCAL_LLM_MODEL=meta-llama/Llama-2-7b-chat-hf
HF_TOKEN=your-huggingface-token
MODEL_CACHE_DIR=./data/models

# LoRA/QLoRA Settings
USE_QUANTIZATION=True
QUANTIZATION_BITS=4
LORA_RANK=8
LORA_ALPHA=32

# ML Configuration
# EEG Analysis
EEG_SAMPLE_RATE=256
EEG_CHANNELS=14
EEG_MODEL_PATH=./data/models/eeg_classifier.pt

# Voice Emotion
VOICE_MODEL_PATH=./data/models/voice_emotion.pt
AUDIO_SAMPLE_RATE=16000

# Food Recognition
FOOD_MODEL_PATH=./data/models/food_recognition.pt
FOOD_CONFIDENCE_THRESHOLD=0.7

# OCR
OCR_ENGINE=easyocr  # Options: tesseract, easyocr
OCR_LANGUAGES=en

# MLOps
# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=wellness-ai

# Weights & Biases
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=wellness-ai
WANDB_ENTITY=your-entity

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW_DAGS_FOLDER=./backend/airflow/dags

# Monitoring
# Prometheus
PROMETHEUS_PORT=9090
METRICS_PORT=9091

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Security & Privacy
# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-bytes-long
ENCRYPT_HEALTH_DATA=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/wellness_ai.log

# Feature Flags
ENABLE_EEG_ANALYSIS=True
ENABLE_VOICE_ANALYSIS=True
ENABLE_FOOD_RECOGNITION=True
ENABLE_OCR=True
ENABLE_AYURVEDA=True
ENABLE_GRAPHRAG=True

# External Services
# Scale AI (for data labeling)
SCALE_API_KEY=your-scale-api-key

# Cloud Storage (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=wellness-ai-data

# Deployment
DOCKER_REGISTRY=your-docker-registry
KUBERNETES_NAMESPACE=wellness-ai
